interface ReservationRepository {
    + save(reservation: Reservation): void
    + findById(id: String): Reservation
    + findByEmployee(employee: Employee): List<Reservation>
    + findByVehicle(vehicle: Vehicle): List<Reservation>
}

interface VehicleRepository {
    + save(vehicle: Vehicle): void
    + findById(id: String): Vehicle
    + findAll(): List<Vehicle>
    + delete(vehicle: Vehicle): void
}

interface EmployeeRepository {
    + findByEntraId(entraId: String): Employee
    + save(employee: Employee): void
}
