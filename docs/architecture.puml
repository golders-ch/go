@startuml

class Vehicle {
    - id: String (final)
    - make: String (final)
    - model: String (final)
    - seats: int (final)
    - doors: int (final)
    - fuelType: enum { PETROL, DIESEL, ELECTRIC, HYBRID } (final)
    - transmission: String (final)
    - licensePlate: String (final)
    - payloadCapacity: double (final)
    - cargoVolume: double (final)
    - status: enum { AVAILABLE, RENTED, MAINTENANCE }
}

class Employee {
    - entraId: String
    - role: enum { EMPLOYEE, ADMIN }
}

class Reservation {
    - id: String
    - reservationNumber: String
    - startDateTime: LocalDateTime
    - endDateTime: LocalDateTime
    - status: enum { PROVISIONAL, CONFIRMED, ACTIVE, COMPLETED, CANCELLED }
}

Employee "1" -- "0..*" Reservation
Vehicle "1" -- "0..*" Reservation

@enduml
